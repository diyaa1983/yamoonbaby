Options -Indexes
AddType image/webp .webp

<IfModule mod_authz_core.c>
    <FilesMatch "(\.git|\.env|\.bak|\.backup|admin-secret\.php|db-config\.php|cards-secret\.php|coupon-token\.php|raffle-session\.php|raffle-db\.php|\.sql|\.log|\.ppk)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(draw.*\.html|info\.php|test\.php|status\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git - [F,L]
    RewriteRule ^styles\.css$ assets/css/styles.css [L]
    RewriteRule ^script\.js$ assets/js/script.js [L]
    RewriteRule ^jordan-areas\.js$ assets/js/jordan-areas.js [L]
    RewriteRule ^baby\.png$ assets/img/baby.png [L]
    RewriteRule ^Home1\.jpg$ assets/img/home.jpg [L]
    RewriteRule ^LOGO\.png$ assets/img/logo.png [L]
    RewriteRule ^Logo/LOGO\.png$ assets/img/logo.png [L]
    RewriteRule ^packs/(.+)$ assets/img/products/$1 [L]
    RewriteRule ^QR/(.+)$ assets/img/qr/$1 [L]
    RewriteRule ^Products/New/(.+)$ assets/img/products/$1 [L]
    RewriteRule ^print-a4-cards\.php$ tools/print-a4-cards.php [L]
    RewriteRule ^print-test-cards\.php$ tools/print-test-cards.php [L]
    RewriteRule ^build-a4-pdf\.php$ tools/build-a4-pdf.php [L]
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set X-XSS-Protection "0"
</IfModule>
